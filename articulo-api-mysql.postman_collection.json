{
  "info": {
    "_postman_id": "9f9d4f6c-6c63-4b51-9b0c-4e4308f1a302",
    "name": "API Articulos MySQL - CRUD",
    "description": "Coleccion de pruebas para la API REST articulo-api-mysql. Ejecutar POST Crear articulo antes de las solicitudes que utilizan {{articuloId}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 - Listar articulos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/articulos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "articulos"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('La API responde con HTTP 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2 - Crear articulo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"nombre\": \"Lapicera\",\n    \"precio\": 200.00\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/articulos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "articulos"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('El articulo fue creado', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "if (pm.response.code === 200) {",
              "    const articulo = pm.response.json();",
              "    if (articulo.id !== undefined) {",
              "        pm.collectionVariables.set('articuloId', articulo.id);",
              "        console.log('ID guardado para las siguientes pruebas:', articulo.id);",
              "    }",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "3 - Consultar articulo por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/articulos/{{articuloId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "articulos",
            "{{articuloId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('El articulo existe y responde con HTTP 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4 - Modificar articulo",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"nombre\": \"Lapicera azul\",\n    \"precio\": 250.00\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/articulos/{{articuloId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "articulos",
            "{{articuloId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('El articulo fue modificado', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5 - Eliminar articulo",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/articulos/{{articuloId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "articulos",
            "{{articuloId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('El articulo fue eliminado', function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6 - Verificar que fue eliminado",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/articulos/{{articuloId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "articulos",
            "{{articuloId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('El articulo ya no existe (HTTP 404)', function () {",
              "    pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "articuloId",
      "value": "1"
    }
  ]
}